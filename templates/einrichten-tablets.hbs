{{!--
  Reiter Tablets: alles, was die Geräte der Spieler am Tisch betrifft.

  Jeder Block ist eine Funktion für sich, mit einem Satz, wofür sie da ist,
  und einem Schalter. Nicht jeder Tisch braucht alle (Ninjo, 12.11.2026);
  ist eine aus, klappt ihr Inhalt zu, damit nur dasteht, was gilt.
--}}
<section class="tab inperson-einrichten-reiter {{tabs.tablets.cssClass}}" data-tab="tablets" data-group="einrichten">
  <p class="inperson-reiter-einleitung">{{localize "INPERSON.Setup.Tablets.Hint"}}</p>

  {{!-- Tischmodus --}}
  <section class="inperson-funktion">
    <header class="inperson-funktion-kopf">
      <i class="fa-solid fa-eye-slash" aria-hidden="true"></i>
      <div class="inperson-funktion-titel">
        <h3>{{localize "INPERSON.Setup.Card.Tischmodus"}}</h3>
        <p>{{localize "INPERSON.Setup.Card.TischmodusFor"}}</p>
      </div>
      <label class="inperson-schalter"><input type="checkbox" name="tischmodusAn" data-funktionsschalter {{#if running}}checked{{/if}}> {{localize "INPERSON.Setup.Use"}}</label>
    </header>
    <div class="inperson-funktion-inhalt">
      <div class="form-group">
        <label>{{localize "INPERSON.Settings.Scope.Name"}}</label>
        <div class="form-fields">
          <select name="blockScope">
            <option value="background" {{#if scopeBackground}}selected{{/if}}>{{localize "INPERSON.Settings.Scope.Background"}}</option>
            <option value="everything" {{#unless scopeBackground}}selected{{/unless}}>{{localize "INPERSON.Settings.Scope.Everything"}}</option>
          </select>
        </div>
        <p class="hint">{{localize "INPERSON.Settings.Scope.Hint"}}</p>
      </div>
      <div class="form-group inperson-when-wide" {{#if scopeBackground}}hidden{{/if}}>
        <label>{{localize "INPERSON.Settings.KeepTokens.Name"}}</label>
        <div class="form-fields"><input type="checkbox" name="keepTokens" {{#if keepTokens}}checked{{/if}}></div>
        <p class="hint">{{localize "INPERSON.Settings.KeepTokens.Hint"}}</p>
      </div>
      <div class="form-group">
        <label>{{localize "INPERSON.Settings.BlockAudio.Name"}}</label>
        <div class="form-fields"><input type="checkbox" name="blockAudio" {{#if blockAudio}}checked{{/if}}></div>
        <p class="hint">{{localize "INPERSON.Settings.BlockAudio.Hint"}}</p>
      </div>
      <div class="form-group">
        <label>{{localize "INPERSON.Settings.AutoNoCanvas.Name"}}</label>
        <div class="form-fields"><input type="checkbox" name="autoNoCanvas" {{#if autoNoCanvas}}checked{{/if}}></div>
        <p class="hint">{{localize "INPERSON.Settings.AutoNoCanvas.Hint"}}</p>
      </div>
      <div class="form-group inperson-breit">
        <label>{{localize "INPERSON.Settings.AllowList.Name"}}</label>
        <div class="form-fields"><textarea name="allowList" rows="2">{{allowList}}</textarea></div>
        <p class="hint">{{localize "INPERSON.Settings.AllowList.Hint"}}</p>
      </div>
      <p class="inperson-funktion-fuss">
        {{localize "INPERSON.Setup.Card.TischmodusWho"}}
        <button type="button" class="inperson-mini" data-action="openControls">
          <i class="fa-solid fa-sliders" aria-hidden="true"></i> {{localize "INPERSON.Menu.Label"}}
        </button>
      </p>
    </div>
  </section>

  {{!-- Blattansicht --}}
  <section class="inperson-funktion">
    <header class="inperson-funktion-kopf">
      <i class="fa-solid fa-tablet-screen-button" aria-hidden="true"></i>
      <div class="inperson-funktion-titel">
        <h3>{{localize "INPERSON.SheetView.Name"}}</h3>
        <p>{{localize "INPERSON.Setup.Card.BlattFor"}}</p>
      </div>
      <label class="inperson-schalter"><input type="checkbox" name="sheetviewEnabled" data-funktionsschalter {{#if sheetviewEnabled}}checked{{/if}}> {{localize "INPERSON.Setup.Use"}}</label>
    </header>
    <div class="inperson-funktion-inhalt">
      <div class="form-group">
        <label>{{localize "INPERSON.SheetView.NoCanvas"}}</label>
        <div class="form-fields"><input type="checkbox" name="noCanvas" {{#if noCanvas}}checked{{/if}}></div>
        <p class="hint">{{localize "INPERSON.SheetView.NoCanvasHint"}}</p>
      </div>
      <div class="form-group">
        <label>{{localize "INPERSON.SheetView.OldIpad"}}</label>
        <div class="form-fields"><input type="checkbox" name="oldIpad" {{#if oldIpad}}checked{{/if}}></div>
        <p class="hint">{{localize "INPERSON.SheetView.OldIpadHint"}}</p>
      </div>
      <div class="form-group">
        <label>{{localize "INPERSON.SheetView.EditPen"}}</label>
        <div class="form-fields"><input type="checkbox" name="editPen" {{#if editPen}}checked{{/if}}></div>
        <p class="hint">{{localize "INPERSON.SheetView.EditPenHint"}}</p>
      </div>
      <div class="form-group">
        <label>{{localize "INPERSON.SheetView.ChatOnUse"}}</label>
        <div class="form-fields"><input type="checkbox" name="chatOnUse" {{#if chatOnUse}}checked{{/if}}></div>
        <p class="hint">{{localize "INPERSON.SheetView.ChatOnUseHint"}}</p>
      </div>

      <h4 class="inperson-zwischentitel">{{localize "INPERSON.SheetView.Showing"}}</h4>
      <div class="form-group">
        <label>{{localize "INPERSON.SheetView.ShowAllow"}}</label>
        <div class="form-fields"><input type="checkbox" name="showAllow" {{#if showAllow}}checked{{/if}}></div>
        <p class="hint">{{localize "INPERSON.SheetView.ShowAllowHint"}}</p>
      </div>
      <div class="form-group">
        <label>{{localize "INPERSON.SheetView.ShowTv"}}</label>
        <div class="form-fields"><input type="checkbox" name="showTv" {{#if showTv}}checked{{/if}}></div>
        <p class="hint">{{localize "INPERSON.SheetView.ShowTvHint"}}</p>
      </div>
      <div class="form-group">
        <label>{{localize "INPERSON.SheetView.ShowGmCopy"}}</label>
        <div class="form-fields"><input type="checkbox" name="showGmCopy" {{#if showGmCopy}}checked{{/if}}></div>
        <p class="hint">{{localize "INPERSON.SheetView.ShowGmCopyHint"}}</p>
      </div>
      <p class="inperson-funktion-fuss">{{localize "INPERSON.Setup.Tablets.SheetViewWho"}}</p>
    </div>
  </section>

  {{!-- Zeit und Wetter --}}
  <section class="inperson-funktion">
    <header class="inperson-funktion-kopf">
      <i class="fa-solid fa-cloud-sun" aria-hidden="true"></i>
      <div class="inperson-funktion-titel">
        <h3>{{localize "INPERSON.Clock.MenuName"}}</h3>
        <p>{{localize "INPERSON.Setup.Card.LeisteFor"}}</p>
      </div>
      <label class="inperson-schalter"><input type="checkbox" name="strip" data-funktionsschalter {{#if strip}}checked{{/if}}> {{localize "INPERSON.Setup.Use"}}</label>
    </header>
    <div class="inperson-funktion-inhalt">
      <div class="inperson-haken-reihe">
        <label><input type="checkbox" name="date" {{#if date}}checked{{/if}}> {{localize "INPERSON.Clock.Field.Date"}}</label>
        <label><input type="checkbox" name="time" {{#if time}}checked{{/if}}> {{localize "INPERSON.Clock.Field.Time"}}</label>
        <label><input type="checkbox" name="weather" {{#if weather}}checked{{/if}}> {{localize "INPERSON.Clock.Field.Weather"}}</label>
        <label><input type="checkbox" name="season" {{#if season}}checked{{/if}}> {{localize "INPERSON.Clock.Field.Season"}}</label>
      </div>
      {{#unless hasWeatherSource}}<p class="hint">{{localize "INPERSON.Clock.NoWeatherSource"}}</p>{{/unless}}
      <div class="form-group">
        <label>{{localize "INPERSON.Clock.Field.Sky"}}</label>
        <div class="form-fields"><input type="checkbox" name="sky" {{#if sky}}checked{{/if}}></div>
        <p class="hint">{{localize "INPERSON.Clock.Field.SkyHint"}}</p>
      </div>
      <div class="form-group">
        <label>{{localize "INPERSON.Clock.Field.SkyTimes"}}</label>
        <div class="form-fields"><input type="checkbox" name="skyTimes" {{#if skyTimes}}checked{{/if}}></div>
        <p class="hint">{{localize "INPERSON.Clock.Field.SkyTimesHint"}}</p>
      </div>
      <div class="form-group">
        <label>{{localize "INPERSON.Clock.Field.Motion"}}</label>
        <div class="form-fields">
          <select name="skyMotion">
            {{#each motionOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>{{/each}}
          </select>
        </div>
        <p class="hint">{{localize "INPERSON.Clock.Field.MotionHint"}}</p>
      </div>
      {{#if hasCalendaria}}
        <div class="form-group">
          <label>{{localize "INPERSON.Clock.Field.SkySource"}}</label>
          <div class="form-fields">
            <select name="skySource">
              {{#each skySourceOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>{{/each}}
            </select>
          </div>
          <p class="hint">{{localize "INPERSON.Clock.Field.SkySourceHint"}}</p>
        </div>
      {{/if}}
    </div>
  </section>

  {{!-- Tauschen --}}
  <section class="inperson-funktion">
    <header class="inperson-funktion-kopf">
      <i class="fa-solid fa-right-left" aria-hidden="true"></i>
      <div class="inperson-funktion-titel">
        <h3>{{localize "INPERSON.TradeSettings.MenuName"}}</h3>
        <p>{{localize "INPERSON.Settings.Trade.Hint"}}</p>
      </div>
      <label class="inperson-schalter"><input type="checkbox" name="trade" data-funktionsschalter {{#if trade}}checked{{/if}}> {{localize "INPERSON.Setup.Use"}}</label>
    </header>
    <div class="inperson-funktion-inhalt">
      <p class="hint">{{#if shops}}{{localize "INPERSON.TradeSettings.Moved"}}{{else}}{{localize "INPERSON.TradeSettings.MovedMissing"}}{{/if}}</p>
      {{#if itemPiles}}<p class="notification warning">{{localize "INPERSON.TradeSettings.ItemPiles"}}</p>{{/if}}
    </div>
  </section>

  <div class="inperson-fremde-teile" data-seite="tablets"></div>
</section>
