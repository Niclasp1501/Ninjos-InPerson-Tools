{{!--
  Reiter Tablets: alles, was die Geräte der Spieler am Tisch betrifft, in der
  Reihenfolge, in der man es einrichtet. Wer ein Tablet hat, steht im Reiter
  Konten und Geräte; hier steht, was dann auf diesen Tablets geschieht.
  Bis 14.2611.81 verteilt auf Tischmodus, Blattansicht, Leiste und Tausch.
--}}
<section class="tab inperson-einrichten-reiter {{tabs.tablets.cssClass}}" data-tab="tablets" data-group="einrichten">

  <p class="notification info">
    {{#if running}}
      {{localize "INPERSON.TableMode.StateOn"}}
    {{else}}
      {{localize "INPERSON.TableMode.StateOff"}}
    {{/if}}
    <button type="button" class="inperson-mini" data-action="openControls">
      <i class="fa-solid fa-sliders" aria-hidden="true"></i> {{localize "INPERSON.Menu.Label"}}
    </button>
  </p>

  <fieldset>
    <legend>{{localize "INPERSON.TableMode.WhatLegend"}}</legend>

    <div class="form-group">
      <label>{{localize "INPERSON.Settings.Scope.Name"}}</label>
      <div class="form-fields">
        <select name="blockScope">
          <option value="background" {{#if scopeBackground}}selected{{/if}}>{{localize "INPERSON.Settings.Scope.Background"}}</option>
          <option value="everything" {{#unless scopeBackground}}selected{{/unless}}>{{localize "INPERSON.Settings.Scope.Everything"}}</option>
        </select>
      </div>
      <p class="hint">{{localize "INPERSON.Settings.Scope.Hint"}}</p>
    </div>

    <div class="inperson-when-wide" {{#if scopeBackground}}hidden{{/if}}>
      <div class="form-group">
        <label>{{localize "INPERSON.Settings.KeepTokens.Name"}}</label>
        <div class="form-fields">
          <input type="checkbox" name="keepTokens" {{#if keepTokens}}checked{{/if}}>
        </div>
        <p class="hint">{{localize "INPERSON.Settings.KeepTokens.Hint"}}</p>
      </div>
    </div>

    <div class="form-group">
      <label>{{localize "INPERSON.Settings.BlockAudio.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" name="blockAudio" {{#if blockAudio}}checked{{/if}}>
      </div>
      <p class="hint">{{localize "INPERSON.Settings.BlockAudio.Hint"}}</p>
    </div>

    <div class="form-group">
      <label>{{localize "INPERSON.Settings.AllowList.Name"}}</label>
      <div class="form-fields">
        <textarea name="allowList" rows="3">{{allowList}}</textarea>
      </div>
      <p class="hint">{{localize "INPERSON.Settings.AllowList.Hint"}}</p>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "INPERSON.Setup.Tablets.CanvasLegend"}}</legend>
    <p class="hint">{{localize "INPERSON.Setup.Tablets.CanvasHint"}}</p>

    <div class="form-group">
      <label>{{localize "INPERSON.Settings.AutoNoCanvas.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" name="autoNoCanvas" {{#if autoNoCanvas}}checked{{/if}}>
      </div>
      <p class="hint">{{localize "INPERSON.Settings.AutoNoCanvas.Hint"}}</p>
    </div>

    <div class="form-group">
      <label>{{localize "INPERSON.SheetView.NoCanvas"}}</label>
      <div class="form-fields">
        <input type="checkbox" name="noCanvas" {{#if noCanvas}}checked{{/if}}>
      </div>
      <p class="hint">{{localize "INPERSON.SheetView.NoCanvasHint"}}</p>
    </div>

    <div class="form-group">
      <label>{{localize "INPERSON.SheetView.OldIpad"}}</label>
      <div class="form-fields">
        <input type="checkbox" name="oldIpad" {{#if oldIpad}}checked{{/if}}>
      </div>
      <p class="hint">{{localize "INPERSON.SheetView.OldIpadHint"}}</p>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "INPERSON.SheetView.MenuName"}}</legend>

    <div class="form-group">
      <label>{{localize "INPERSON.SheetView.Name"}}</label>
      <div class="form-fields">
        <input type="checkbox" name="sheetviewEnabled" {{#if sheetviewEnabled}}checked{{/if}}>
      </div>
      <p class="hint">{{localize "INPERSON.SheetView.EnabledHint"}} {{localize "INPERSON.Setup.Tablets.SheetViewWho"}}</p>
    </div>

    <h4>{{localize "INPERSON.SheetView.Behaviour"}}</h4>
    <div class="form-group">
      <label>{{localize "INPERSON.SheetView.EditPen"}}</label>
      <div class="form-fields"><input type="checkbox" name="editPen" {{#if editPen}}checked{{/if}}></div>
      <p class="hint">{{localize "INPERSON.SheetView.EditPenHint"}}</p>
    </div>
    <div class="form-group">
      <label>{{localize "INPERSON.SheetView.ChatOnUse"}}</label>
      <div class="form-fields"><input type="checkbox" name="chatOnUse" {{#if chatOnUse}}checked{{/if}}></div>
      <p class="hint">{{localize "INPERSON.SheetView.ChatOnUseHint"}}</p>
    </div>

    <h4>{{localize "INPERSON.SheetView.Showing"}}</h4>
    <div class="form-group">
      <label>{{localize "INPERSON.SheetView.ShowAllow"}}</label>
      <div class="form-fields"><input type="checkbox" name="showAllow" {{#if showAllow}}checked{{/if}}></div>
      <p class="hint">{{localize "INPERSON.SheetView.ShowAllowHint"}}</p>
    </div>
    <div class="form-group">
      <label>{{localize "INPERSON.SheetView.ShowTv"}}</label>
      <div class="form-fields"><input type="checkbox" name="showTv" {{#if showTv}}checked{{/if}}></div>
      <p class="hint">{{localize "INPERSON.SheetView.ShowTvHint"}}</p>
    </div>
    <div class="form-group">
      <label>{{localize "INPERSON.SheetView.ShowGmCopy"}}</label>
      <div class="form-fields"><input type="checkbox" name="showGmCopy" {{#if showGmCopy}}checked{{/if}}></div>
      <p class="hint">{{localize "INPERSON.SheetView.ShowGmCopyHint"}}</p>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "INPERSON.Clock.Group.Strip"}}</legend>
    <p class="hint">{{localize "INPERSON.Clock.Group.StripHint"}}</p>

    <div class="form-group">
      <label>{{localize "INPERSON.Clock.Field.Strip"}}</label>
      <div class="form-fields"><input type="checkbox" name="strip" {{#if strip}}checked{{/if}}></div>
      <p class="hint">{{localize "INPERSON.Clock.Field.StripHint"}}</p>
    </div>
    <div class="form-group">
      <label>{{localize "INPERSON.Clock.Field.Date"}}</label>
      <div class="form-fields"><input type="checkbox" name="date" {{#if date}}checked{{/if}}></div>
    </div>
    <div class="form-group">
      <label>{{localize "INPERSON.Clock.Field.Time"}}</label>
      <div class="form-fields"><input type="checkbox" name="time" {{#if time}}checked{{/if}}></div>
    </div>
    <div class="form-group">
      <label>{{localize "INPERSON.Clock.Field.Sky"}}</label>
      <div class="form-fields"><input type="checkbox" name="sky" {{#if sky}}checked{{/if}}></div>
      <p class="hint">{{localize "INPERSON.Clock.Field.SkyHint"}}</p>
    </div>
    <div class="form-group">
      <label>{{localize "INPERSON.Clock.Field.SkyTimes"}}</label>
      <div class="form-fields"><input type="checkbox" name="skyTimes" {{#if skyTimes}}checked{{/if}}></div>
      <p class="hint">{{localize "INPERSON.Clock.Field.SkyTimesHint"}}</p>
    </div>
    <div class="form-group">
      <label>{{localize "INPERSON.Clock.Field.Motion"}}</label>
      <div class="form-fields">
        <select name="skyMotion">
          {{#each motionOptions}}
            <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
          {{/each}}
        </select>
      </div>
      <p class="hint">{{localize "INPERSON.Clock.Field.MotionHint"}}</p>
    </div>
    {{#if hasCalendaria}}
      <div class="form-group">
        <label>{{localize "INPERSON.Clock.Field.SkySource"}}</label>
        <div class="form-fields">
          <select name="skySource">
            {{#each skySourceOptions}}
              <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
            {{/each}}
          </select>
        </div>
        <p class="hint">{{localize "INPERSON.Clock.Field.SkySourceHint"}}</p>
      </div>
    {{/if}}
    <div class="form-group">
      <label>{{localize "INPERSON.Clock.Field.Weather"}}</label>
      <div class="form-fields"><input type="checkbox" name="weather" {{#if weather}}checked{{/if}}></div>
      {{#unless hasWeatherSource}}<p class="hint">{{localize "INPERSON.Clock.NoWeatherSource"}}</p>{{/unless}}
    </div>
    <div class="form-group">
      <label>{{localize "INPERSON.Clock.Field.Season"}}</label>
      <div class="form-fields"><input type="checkbox" name="season" {{#if season}}checked{{/if}}></div>
      <p class="hint">{{localize "INPERSON.Clock.Field.SeasonHint"}}</p>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "INPERSON.TradeSettings.Group"}}</legend>
    <p class="hint">{{#if shops}}{{localize "INPERSON.TradeSettings.Moved"}}{{else}}{{localize "INPERSON.TradeSettings.MovedMissing"}}{{/if}}</p>
    <div class="form-group">
      <label>{{localize "INPERSON.Settings.Trade.Name"}}</label>
      <div class="form-fields"><input type="checkbox" name="trade" {{#if trade}}checked{{/if}}></div>
      <p class="hint">{{localize "INPERSON.Settings.Trade.Hint"}}</p>
    </div>
    {{#if itemPiles}}<p class="notification warning">{{localize "INPERSON.TradeSettings.ItemPiles"}}</p>{{/if}}
  </fieldset>

  <div class="inperson-fremde-teile" data-seite="tablets"></div>
</section>
