{{!--
  Trading: one switch, and the sentence saying where the rest of it lives.

  Until 2026-09-08 there were three switches and a door into the logbook here.
  The trade moved to Ninjo's DnD Shops & Trade; whether the gamemaster joins in
  and whether trades are written down are settings of that module now. What
  stays here is whether this module offers a way in at all.
--}}
<section class="inperson-body">

  <div class="inperson-scene">
    <div class="inperson-scene-head">
      <h3><i class="fa-solid fa-right-left" aria-hidden="true"></i> {{localize "INPERSON.TradeSettings.Group"}}</h3>
    </div>
    <p class="inperson-hint">
      <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
      {{#if shops}}
        {{localize "INPERSON.TradeSettings.Moved"}}
      {{else}}
        {{localize "INPERSON.TradeSettings.MovedMissing"}}
      {{/if}}
    </p>
  </div>

  <label class="inperson-pick-row">
    <input type="checkbox" name="trade" {{checked trade}}>
    <span class="inperson-pick-name">
      {{localize "INPERSON.Settings.Trade.Name"}}
      <em>{{localize "INPERSON.Settings.Trade.Hint"}}</em>
    </span>
  </label>

  {{#if itemPiles}}
    <p class="inperson-hint warn">
      <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
      {{localize "INPERSON.TradeSettings.ItemPiles"}}
    </p>
  {{/if}}

  <footer class="inperson-foot">
    <button type="submit" class="inperson-master-toggle">
      <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
      <span>{{localize "INPERSON.Clock.Save"}}</span>
    </button>
  </footer>
</section>
