{{!--
  Ein Schalter, die Liste, drei Zeilen Verhalten. Die Erklärungen stecken in
  Tooltips (i) - sichtbar war das eine Textwand, in der die Konten untergingen.
--}}
<section class="inperson-body inperson-sv-settings">

  <label class="inperson-pick-row {{#if enabled}}on{{/if}}">
    <input type="checkbox" name="enabled" {{checked enabled}}>
    <span class="inperson-pick-name">
      {{localize "INPERSON.SheetView.Name"}}
      <em>{{localize "INPERSON.SheetView.EnabledHint"}}</em>
    </span>
    <i class="fa-solid fa-circle-info inperson-sv-info" data-tooltip="{{localize 'INPERSON.SheetView.GroupHint'}}" aria-hidden="true"></i>
  </label>

  <h3 class="inperson-sv-sub">
    <i class="fa-solid fa-users" aria-hidden="true"></i> {{localize "INPERSON.SheetView.Who"}}
    <i class="fa-solid fa-circle-info inperson-sv-info" data-tooltip="{{localize 'INPERSON.SheetView.WhoListHint'}}" aria-hidden="true"></i>
  </h3>

  {{#if hasUsers}}
    <div class="inperson-partner-list inperson-sv-users">
      {{#each users}}
        <label class="inperson-pick-row {{#if this.checked}}on{{/if}}">
          <input type="checkbox" name="user.{{this.id}}" {{checked this.checked}}>
          <img class="inperson-portrait" src="{{this.actorImg}}" alt="">
          <span class="inperson-pick-name">
            {{this.name}}
            {{#if this.actorName}}<em>{{this.actorName}}</em>{{/if}}
          </span>
          {{#if this.online}}<span class="inperson-tag ok">{{localize "INPERSON.SheetView.Online"}}</span>{{/if}}
          <button type="button" class="inperson-mini inperson-sv-reset" data-action="reset" data-user="{{this.id}}"
                  data-tooltip="{{localize 'INPERSON.SheetView.ResetHint'}}"
                  aria-label="{{localize 'INPERSON.SheetView.ResetHint'}}">
            <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
          </button>
        </label>
      {{/each}}
    </div>
  {{else}}
    <p class="inperson-hint">{{localize "INPERSON.SheetView.NoUsers"}}</p>
  {{/if}}

  <h3 class="inperson-sv-sub"><i class="fa-solid fa-sliders" aria-hidden="true"></i> {{localize "INPERSON.SheetView.Behaviour"}}</h3>

  <div class="inperson-sv-verhalten">
    <label class="inperson-pick-row {{#if noCanvas}}on{{/if}}">
      <input type="checkbox" name="noCanvas" {{checked noCanvas}}>
      <span class="inperson-pick-name">{{localize "INPERSON.SheetView.NoCanvas"}}</span>
      <i class="fa-solid fa-circle-info inperson-sv-info" data-tooltip="{{localize 'INPERSON.SheetView.NoCanvasHint'}}" aria-hidden="true"></i>
    </label>

    <label class="inperson-pick-row {{#if chatOnUse}}on{{/if}}">
      <input type="checkbox" name="chatOnUse" {{checked chatOnUse}}>
      <span class="inperson-pick-name">{{localize "INPERSON.SheetView.ChatOnUse"}}</span>
      <i class="fa-solid fa-circle-info inperson-sv-info" data-tooltip="{{localize 'INPERSON.SheetView.ChatOnUseHint'}}" aria-hidden="true"></i>
    </label>
  </div>

  <footer class="inperson-foot">
    <button type="submit" class="inperson-master-toggle">
      <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
      <span>{{localize "INPERSON.Clock.Save"}}</span>
    </button>
  </footer>

</section>
