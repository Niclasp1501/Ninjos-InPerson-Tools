{{!--
  One group, because all of these belong to the table. There was briefly a
  second one for per-device choices; the table decided the strip is a
  presentation choice for the whole group, like the scene everyone looks at.
--}}
<section class="inperson-body">

  <div class="inperson-scene">
    <div class="inperson-scene-head">
      <h3><i class="fa-solid fa-clock" aria-hidden="true"></i> {{localize "INPERSON.Clock.Group.Strip"}}</h3>
    </div>
    <p class="inperson-hint">
      <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
      {{localize "INPERSON.Clock.Group.StripHint"}}
    </p>
  </div>

  <label class="inperson-pick-row">
    <input type="checkbox" name="strip" {{checked strip}}>
    <span class="inperson-pick-name">
      {{localize "INPERSON.Clock.Field.Strip"}}
      <em>{{localize "INPERSON.Clock.Field.StripHint"}}</em>
    </span>
  </label>

  <label class="inperson-pick-row">
    <input type="checkbox" name="date" {{checked date}}>
    <span class="inperson-pick-name">{{localize "INPERSON.Clock.Field.Date"}}</span>
  </label>

  <label class="inperson-pick-row">
    <input type="checkbox" name="time" {{checked time}}>
    <span class="inperson-pick-name">{{localize "INPERSON.Clock.Field.Time"}}</span>
  </label>

  <label class="inperson-pick-row">
    <input type="checkbox" name="sky" {{checked sky}}>
    <span class="inperson-pick-name">
      {{localize "INPERSON.Clock.Field.Sky"}}
      <em>{{localize "INPERSON.Clock.Field.SkyHint"}}</em>
    </span>
  </label>

  <label class="inperson-pick-row">
    <input type="checkbox" name="skyTimes" {{checked skyTimes}}>
    <span class="inperson-pick-name">
      {{localize "INPERSON.Clock.Field.SkyTimes"}}
      <em>{{localize "INPERSON.Clock.Field.SkyTimesHint"}}</em>
    </span>
  </label>

  <label class="inperson-pick-row">
    <span class="inperson-pick-name">
      {{localize "INPERSON.Clock.Field.Motion"}}
      <em>{{localize "INPERSON.Clock.Field.MotionHint"}}</em>
    </span>
    <select name="skyMotion" class="inperson-sky-source">
      {{#each motionOptions}}
        <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
      {{/each}}
    </select>
  </label>

  {{#if hasCalendaria}}
    <label class="inperson-pick-row">
      <span class="inperson-pick-name">
        {{localize "INPERSON.Clock.Field.SkySource"}}
        <em>{{localize "INPERSON.Clock.Field.SkySourceHint"}}</em>
      </span>
      <select name="skySource" class="inperson-sky-source">
        {{#each skySourceOptions}}
          <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
        {{/each}}
      </select>
    </label>
  {{/if}}

  <label class="inperson-pick-row">
    <input type="checkbox" name="weather" {{checked weather}}>
    <span class="inperson-pick-name">
      {{localize "INPERSON.Clock.Field.Weather"}}
      {{#unless hasWeatherSource}}<em>{{localize "INPERSON.Clock.NoWeatherSource"}}</em>{{/unless}}
    </span>
  </label>

  <label class="inperson-pick-row">
    <input type="checkbox" name="season" {{checked season}}>
    <span class="inperson-pick-name">
      {{localize "INPERSON.Clock.Field.Season"}}
      <em>{{localize "INPERSON.Clock.Field.SeasonHint"}}</em>
    </span>
  </label>

  <footer class="inperson-foot">
    <button type="submit" class="inperson-master-toggle">
      <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
      <span>{{localize "INPERSON.Clock.Save"}}</span>
    </button>
  </footer>

</section>
