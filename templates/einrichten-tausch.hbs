{{!-- Reiter Tauschen. Eine Vorlage je Reiter: Foundry verlangt genau ein Element je Teil. --}}
<section class="tab inperson-einrichten-reiter {{tabs.tausch.cssClass}}" data-tab="tausch" data-group="einrichten">
  <p class="inperson-reiter-einleitung">{{localize "INPERSON.Settings.Trade.Hint"}}</p>
  <p class="inperson-aus-hinweis"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> {{#if shops}}{{localize "INPERSON.TradeSettings.Moved"}}{{else}}{{localize "INPERSON.TradeSettings.MovedMissing"}}{{/if}}</p>
  {{#if itemPiles}}<p class="notification warning">{{localize "INPERSON.TradeSettings.ItemPiles"}}</p>{{/if}}
</section>
